# Copy to gitignored .env at the repository root for docker compose / VPS.
# For `npm run dev`, copy Frontend/.env.example instead.
#
# VPS (cùng máy với Max Claw, domain khác):
#   production  APP_PORT=2005  COMPOSE_PROJECT_NAME=itba-ocr-production
#               /opt/ITBA-OCR/production
#   staging     APP_PORT=2026  COMPOSE_PROJECT_NAME=itba-ocr-staging
#               /opt/ITBA-OCR/staging
# Local compose: APP_PORT=3000

DOCKER_IMAGE=ghcr.io/dattran26/down-town:local
COMPOSE_PROJECT_NAME=town-hown
APP_PORT=3000

# Public — baked into the image at `docker compose build` / GHCR publish.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Staging image: https://staging.wpcteam.shop
# Production image: https://production.wpcteam.shop
# Local compose/dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ENABLE_TURNSTILE=

# Server-only — runtime env_file, never Docker ARG.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
