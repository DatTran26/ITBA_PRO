# Copy to gitignored .env at the repository root for docker compose / VPS.
# For `npm run dev`, copy Frontend/.env.example instead.
#
# VPS (cùng máy với Max Claw, domain khác):
#   production  APP_PORT=2005  COMPOSE_PROJECT_NAME=itba-ocr-production
#               /opt/ITBA-OCR/production
#   staging     APP_PORT=2026  COMPOSE_PROJECT_NAME=itba-ocr-staging
#               /opt/ITBA-OCR/staging
# Local compose: APP_PORT=3000

DOCKER_IMAGE=ghcr.io/dattran26/down-town:local
VISION_AI_IMAGE=ghcr.io/dattran26/down-town-vision-ai:local
VISION_OCR_IMAGE=ghcr.io/dattran26/down-town-vision-ocr:local
COMPOSE_PROJECT_NAME=town-hown
APP_PORT=3000

# Public — baked into the image at `docker compose build` / GHCR publish.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Staging image: https://staging.wpcteam.shop
# Production image: https://production.wpcteam.shop
# Local compose/dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ENABLE_TURNSTILE=
# Public widget key from Cloudflare Turnstile. Never put the widget secret here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — runtime env_file, never Docker ARG.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
VISION_OCR_URL=http://vision-ocr-api:8000
VISION_AI_URL=http://vision-ai-api:8000
FACE_DATA_HOST_DIR=./data/vision-ai/faces
VIOLATION_DATA_HOST_DIR=./data/vision-ai/violations
INSIGHTFACE_HOST_DIR=./data/vision-ai/insightface
VISION_AI_CONFIG_HOST_DIR=./data/vision-ai/config
FACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.75
VISION_AI_MODEL_HOST_DIR=./models/vision-ai
# Compose container path. Local Python uses modules/vision-ai/backend/.env instead.
BEHAVIOR_MODEL_PATH=/models/behavior.pt
BEHAVIOR_CONFIDENCE=0.25
BEHAVIOR_LABELS=smoke,Cigarette,empty_seat,un-occupied_desk
VISION_OCR_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://web:3000
# Face ID sign-in. Staging/production public hosts are allowlisted in code;
# set true so a running image can enable Face ID before that image is rebuilt.
FACE_LOGIN_ENABLED=true
