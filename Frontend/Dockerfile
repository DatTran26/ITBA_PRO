# /Dockerfile
# syntax=docker/dockerfile:1

# ─── Stage 1: Base ───────────────────────────────────────────────────────────
# Shared base image used by all stages
FROM node:20-alpine AS base

LABEL org.opencontainers.image.title="ITBA AI"
LABEL org.opencontainers.image.description="ITBA AI - Next.js 15 Application"
LABEL org.opencontainers.image.source="https://gitlab.com"

# ─── Stage 2: Dependencies ───────────────────────────────────────────────────
# Install production + dev dependencies (needed for build)
FROM base AS deps

# libc6-compat is required for some native Node.js modules on Alpine
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy lockfiles first to maximise Docker layer caching
COPY package.json package-lock.json ./
RUN npm ci

# ─── Stage 3: Builder ────────────────────────────────────────────────────────
# Compile the Next.js application into a standalone bundle
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* vars are baked into the client bundle at build time,
# so they MUST be provided as --build-arg in CI and set to ENV here.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ─── Stage 4: Runner (Production) ───────────────────────────────────────────
# Minimal image; only contains the compiled standalone output
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# NOTE: NEXT_PUBLIC_* vars are already embedded in the JS bundle by the builder
# stage. Re-declaring them here is only needed if server-side code reads them
# at runtime (e.g. via process.env). Remove if not required to keep the image clean.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY

# Create a non-root system user for security (single RUN to reduce layers)
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy only the standalone output (no node_modules, no source code)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# Version approval appends to this file at runtime.
COPY --from=builder --chown=nextjs:nodejs /app/CHANGELOG.md ./CHANGELOG.md

# Drop root privileges before starting the process
USER nextjs

EXPOSE 3000

# server.js is auto-generated by Next.js when output: 'standalone' is set
CMD ["node", "server.js"]
