# Public (baked into the browser bundle — never put secrets here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local: http://localhost:3000
# GHCR staging: https://staging.wpcteam.shop
# GHCR production: https://production.wpcteam.shop
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local Face ID + vision without a Supabase project
NEXT_PUBLIC_DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_LOGIN_EMAIL=test.superadmin@itba.ai
DEV_LOGIN_ACCOUNTS_FILE=
DEV_LOGIN_PASSWORD=localdev
# Set both values for local Turnstile testing. The site key is public.
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Recruitment Excel report's AI insight sheet only (rest of the app uses OpenAI above).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DATABASE_URL=
VISION_OCR_URL=http://localhost:8000
VISION_AI_URL=http://localhost:8001
