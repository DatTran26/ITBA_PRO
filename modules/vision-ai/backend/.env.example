# Local run (no Docker). Copy to .env.
# Relative paths are from src/. Absolute Windows paths also work, e.g.
# BEHAVIOR_MODEL_PATH=D:\weights\behavior.pt

FACE_DATA_DIR=data/vision-ai/faces
VIOLATION_DATA_DIR=data/vision-ai/violations
FACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.75
BEHAVIOR_MODEL_PATH=models/vision-ai/behavior.pt
BEHAVIOR_CONFIDENCE=0.25
BEHAVIOR_LABELS=smoke,Cigarette,empty_seat,un-occupied_desk
