# Copy to gitignored `.env` at /opt/ITBA-OCR/staging on the VPS.
# Do not commit real values. GitHub Actions never overwrites this file.

COMPOSE_PROJECT_NAME=itba-ocr-staging
DOCKER_IMAGE=ghcr.io/dattran26/down-town:staging
APP_PORT=2026
TRAEFIK_HOST=staging.wpcteam.shop

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://staging.wpcteam.shop
NEXT_PUBLIC_ENABLE_TURNSTILE=false

SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
