# Copy to gitignored `.env` at /opt/ITBA-OCR/production on the VPS.
# Do not commit real values. GitHub Actions never overwrites this file.

COMPOSE_PROJECT_NAME=itba-ocr-production
DOCKER_IMAGE=ghcr.io/dattran26/down-town:latest
APP_PORT=2005
TRAEFIK_HOST=production.wpcteam.shop

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://production.wpcteam.shop
NEXT_PUBLIC_ENABLE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Face ID sign-in on production.wpcteam.shop. Also enable on extra hostnames if needed.
FACE_LOGIN_ENABLED=true

SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
VISION_OCR_URL=http://vision-ocr-api:8000
VISION_AI_URL=http://vision-ai-api:8000
VISION_AI_IMAGE=ghcr.io/dattran26/down-town-vision-ai:latest
VISION_OCR_IMAGE=ghcr.io/dattran26/down-town-vision-ocr:latest
VISION_OCR_CORS_ALLOWED_ORIGINS=https://production.wpcteam.shop,http://web:3000
FACE_DATA_HOST_DIR=./data/vision-ai/faces
VIOLATION_DATA_HOST_DIR=./data/vision-ai/violations
INSIGHTFACE_HOST_DIR=./data/vision-ai/insightface
VISION_AI_CONFIG_HOST_DIR=./data/vision-ai/config
VISION_AI_MODEL_HOST_DIR=./models/vision-ai
FACE_MODEL_NAME=buffalo_l
FACE_MATCH_THRESHOLD=0.75
BEHAVIOR_MODEL_PATH=/models/behavior.pt
BEHAVIOR_CONFIDENCE=0.25
BEHAVIOR_LABELS=smoke,Cigarette,empty_seat,un-occupied_desk
